<Project Sdk="Microsoft.NET.Sdk">
  <!-- AUTH4D-169: ASP.NET Core authentication handler for Auth4.Server. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Auth4.Server.AspNetCore</RootNamespace>
    <PackageId>Auth4.Server.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>auth4.dev</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>ASP.NET Core bearer authentication for auth4.dev access tokens.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Auth4.Server/Auth4.Server.csproj" />
  </ItemGroup>
</Project>
